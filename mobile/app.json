{
  "expo": {
    "name": "Obras Teccel",
    "slug": "obras-wise-mobile",
    "version": "2.2.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "obraswise",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#FF0000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.obraswise.mobile",
      "buildNumber": "8",
      "infoPlist": {
        "NSCameraUsageDescription": "Este app precisa acessar a câmera para tirar fotos das obras.",
        "NSPhotoLibraryUsageDescription": "Este app precisa acessar suas fotos para selecionar imagens.",
        "NSPhotoLibraryAddUsageDescription": "Este app precisa salvar fotos das obras na sua galeria.",
        "NSLocationWhenInUseUsageDescription": "Este app precisa acessar sua localização para registrar o local das fotos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF0000"
      },
      "package": "com.obraswise.mobile",
      "versionCode": 13,
      "minSdkVersion": 26,
      "targetSdkVersion": 34,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      },
      "jsEngine": "hermes",
      "enableProguardInReleaseBuilds": true,
      "enableShrinkResourcesInReleaseBuilds": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Este app precisa acessar suas fotos para selecionar imagens.",
          "cameraPermission": "Este app precisa acessar a câmera para tirar fotos das obras."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Este app precisa acessar sua localização para registrar o local das fotos."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Este app precisa salvar fotos das obras na sua galeria.",
          "savePhotosPermission": "Este app precisa salvar fotos das obras na sua galeria.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "22bdc367-038a-43b2-b50a-1b8133c0540b"
      }
    },
    "owner": "mateus_almeida",
    "assetBundlePatterns": [
      "**/*"
    ]
  }
}
